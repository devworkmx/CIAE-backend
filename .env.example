# Database
POSTGRES_USER=ciae_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=ciae_db
DATABASE_URL=postgresql://ciae_user:your_password_here@localhost:5432/ciae_db

# Security & JWT
SECRET_KEY=generate_with_python_secrets
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# URLs & CORS
ALLOWED_ORIGINS=https://localhost:5173
FRONTEND_URL=https://localhost:5173
FRONTEND_VALIDATION_URL=https://localhost:5173/validar

# Session Cookies (set false for local HTTP)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=ciae_token

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=CIAE Certificaciones <onboarding@resend.dev>
