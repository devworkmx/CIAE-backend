# Copia este archivo como ".env" y rellena valores reales.
# NUNCA subas el archivo ".env" real a git (agrégalo a .gitignore).

# ---- Base de datos (usadas también por docker-compose.yml) ----
POSTGRES_USER=ciae_user
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-fuerte
POSTGRES_DB=ciae_db

# Cadena de conexión que usa la app (debe coincidir con lo de arriba).
# Si el backend corre fuera de docker-compose, usa localhost o la IP del host;
# si corre dentro de la misma red de docker-compose, usa "db" como host.
DATABASE_URL=postgresql://ciae_user:cambia-esto-por-una-contraseña-fuerte@localhost:5432/ciae_db

# ---- Seguridad de la aplicación ----
# Genera uno único y secreto, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=reemplaza-esto-con-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- CORS ----
# Dominio(s) reales del frontend en producción, separados por comas.
# En desarrollo local puedes dejar http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ---- URLs del frontend ----
FRONTEND_URL=http://localhost:5173
FRONTEND_VALIDATION_URL=http://localhost:5173/validar

# ---- Cookie de sesión ----
# En producción, DEJA COOKIE_SECURE=true (requiere HTTPS real; si no,
# el navegador nunca guardará la cookie). Cámbialo a false SOLO si estás
# probando en local con el backend corriendo sobre http:// puro sin
# certificado (por ejemplo, uvicorn sin --ssl y sin proxy con TLS).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_NAME=ciae_token

# ---- Correo (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
